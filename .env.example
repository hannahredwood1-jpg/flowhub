# ── Database (Supabase → Project Settings → Database → Connection string) ──
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Auth.js ──
AUTH_SECRET=""                 # generate: npx auth secret
AUTH_URL="http://localhost:3000"

# ── Discord application (discord.com/developers/applications) ──
AUTH_DISCORD_ID=""             # OAuth2 → Client ID
AUTH_DISCORD_SECRET=""         # OAuth2 → Client Secret
DISCORD_GUILD_ID=""            # your server's ID (Developer Mode → right-click server → Copy Server ID)
DISCORD_ADMIN_ROLE_IDS=""      # comma-separated role IDs for "Admin"
DISCORD_COACH_ROLE_IDS=""      # comma-separated role IDs for "Trading Coach"
DISCORD_BOT_TOKEN=""           # optional but recommended: bot in your server, used to re-check roles

# ── Security ──
TOKEN_ENCRYPTION_KEY=""        # 32 random bytes, base64: openssl rand -base64 32
